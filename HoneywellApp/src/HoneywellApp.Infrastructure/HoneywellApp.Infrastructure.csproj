<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HoneywellApp.Infrastructure</RootNamespace>
    <AssemblyName>HoneywellApp.Infrastructure</AssemblyName>
    <!-- Suppress Connectivity/MAUI platform API on net8.0 desktop target -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Plugin.BLE" Version="3.1.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="8.0.82" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HoneywellApp.Application\HoneywellApp.Application.csproj" />
    <ProjectReference Include="..\HoneywellApp.Persistence\HoneywellApp.Persistence.csproj" />
  </ItemGroup>

</Project>

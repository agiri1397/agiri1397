@page "/products"
@page "/"
@inject IProductService ProductService
@inject IBluetoothPrinterService BluetoothService
@inject ISyncService SyncService

<PageTitle>Productos</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
    <MudText Typo="Typo.h5">Productos</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudChip Color="@(_isOnline ? Color.Success : Color.Default)" Size="Size.Small">
            @(_isOnline ? "Online" : "Offline")
        </MudChip>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                   OnClick="LoadProducts" Disabled="@_isLoading">
            Actualizar
        </MudButton>
    </MudStack>
</MudStack>

@if (_isFromCache)
{
    <MudAlert Severity="Severity.Info" Class="mb-3">Mostrando datos del caché local (sin conexión al API).</MudAlert>
}

@if (_isLoading)
{
    <MudStack AlignItems="AlignItems.Center" Class="py-4">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Class="mt-2">Cargando productos...</MudText>
    </MudStack>
}
else if (_products.Any())
{
    <MudTable Items="_products" Hover="true" Striped="true" T="ProductDto">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>SKU</MudTh>
            <MudTh>Categoría</MudTh>
            <MudTh>Precio</MudTh>
            <MudTh>Stock</MudTh>
            <MudTh>Sync</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Name</MudTd>
            <MudTd DataLabel="SKU"><code>@context.SKU</code></MudTd>
            <MudTd DataLabel="Categoría">@context.Category</MudTd>
            <MudTd DataLabel="Precio">$@context.Price.ToString("F2")</MudTd>
            <MudTd DataLabel="Stock">@context.StockQuantity</MudTd>
            <MudTd DataLabel="Sync">
                <MudChip Color="@(context.IsSynced ? Color.Success : Color.Warning)" Size="Size.Small">
                    @(context.IsSynced ? "Sync" : "Pendiente")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Acciones">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary"
                           OnClick="() => PrintLabel(context)"
                           Disabled="@(!BluetoothService.IsConnected)">
                    Imprimir
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <MudStack AlignItems="AlignItems.Center" Class="py-5">
        <MudText Color="Color.Secondary">No hay productos disponibles.</MudText>
    </MudStack>
}

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <MudAlert Severity="Severity.Info" Class="mt-3">@_statusMessage</MudAlert>
}

@code {
    private List<ProductDto> _products = [];
    private bool _isLoading = true;
    private bool _isFromCache;
    private bool _isOnline;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        SyncService.ConnectivityChanged += OnConnectivityChanged;
        _isOnline = SyncService.IsOnline;
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        _isLoading = true;
        _statusMessage = null;
        StateHasChanged();

        var result = await ProductService.GetAllProductsAsync();
        _products = result.Products.ToList();
        _isFromCache = result.IsFromCache;
        _isOnline = SyncService.IsOnline;
        _isLoading = false;
    }

    private async Task PrintLabel(ProductDto product)
    {
        var success = await BluetoothService.PrintProductLabelAsync(
            product.Name, product.SKU, product.Barcode, product.Price);
        _statusMessage = success
            ? $"Etiqueta de '{product.Name}' enviada a la impresora."
            : "Error al imprimir. Verifique la conexión Bluetooth.";
    }

    private void OnConnectivityChanged(object? sender, bool isOnline)
    {
        _isOnline = isOnline;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() =>
        SyncService.ConnectivityChanged -= OnConnectivityChanged;
}

@page "/login"
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ThemeService Theme
@inject IJSRuntime JS

<PageTitle>Iniciar Sesión</PageTitle>

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="Theme.IsDark" />

<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%); padding:1rem;">
    <MudCard Style="width:100%; max-width:420px;" Elevation="8">
        <MudCardContent Class="pa-8">
            <div style="text-align:center; margin-bottom:1.5rem;">
                <MudAvatar Style="background:#E31837; width:64px; height:64px; margin:0 auto 1rem; font-size:1.8rem;">H</MudAvatar>
                <MudText Typo="Typo.h5" Color="Color.Primary"><b>HoneywellApp</b></MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Ingresa tus credenciales</MudText>
            </div>

            <EditForm Model="@_model" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_model.Email"
                              Label="Correo electrónico"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Class="mb-4"
                              FullWidth="true" />

                <MudTextField @bind-Value="_model.Password"
                              Label="Contraseña"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInputType"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordIcon"
                              OnAdornmentClick="TogglePassword"
                              Class="mb-4"
                              FullWidth="true" />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMessage</MudAlert>
                }

                @if (_isOfflineMode)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3">
                        Sin conexión — usando credenciales guardadas localmente.
                    </MudAlert>
                }

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@_isLoading"
                           Class="mb-4">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Verificando...</span>
                    }
                    else
                    {
                        <span>Iniciar Sesión</span>
                    }
                </MudButton>
            </EditForm>

            <div style="display:flex; align-items:center; justify-content:center; gap:0.5rem;">
                <MudText Typo="Typo.body2">@(Theme.IsDark ? "🌙 Modo oscuro" : "☀️ Modo claro")</MudText>
                <MudSwitch @bind-Value="Theme.IsDark" Color="Color.Primary" T="bool"
                           ValueChanged="OnThemeChanged" />
            </div>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private readonly LoginRequest _model = new();
    private string? _errorMessage;
    private bool _isLoading;
    private bool _isOfflineMode;
    private bool _showPassword;
    private InputType _passwordInputType => _showPassword ? InputType.Text : InputType.Password;
    private string _passwordIcon => _showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;

    private MudTheme _theme = new MudTheme
    {
        PaletteLight = new PaletteLight { Primary = "#E31837", PrimaryDarken = "#B5122B" },
        PaletteDark  = new PaletteDark  { Primary = "#E31837", Background = "#0D0D0D", Surface = "#1E1E2E" }
    };

    protected override async Task OnInitializedAsync()
    {
        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "dark_mode");
        Theme.Init(stored);
        if (await AuthService.IsAuthenticatedAsync())
            Nav.NavigateTo("/products");
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var result = await AuthService.LoginAsync(_model);
            if (result.Success)
            {
                _isOfflineMode = result.IsOfflineLogin;
                Nav.NavigateTo("/products");
            }
            else
            {
                _errorMessage = result.ErrorMessage;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void TogglePassword() => _showPassword = !_showPassword;

    private async Task OnThemeChanged(bool value)
    {
        Theme.Toggle();
        await JS.InvokeVoidAsync("localStorage.setItem", "dark_mode", Theme.StorageValue);
    }
}

@page "/bluetooth"
@inject IBluetoothPrinterService BluetoothService
@implements IDisposable

<PageTitle>Impresora Bluetooth</PageTitle>

<h3>Impresora Honeywell Bluetooth</h3>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Estado de conexión</h5>
        @if (BluetoothService.IsConnected)
        {
            <div class="d-flex align-items-center">
                <span class="badge bg-success me-2">Conectado</span>
                <strong>@BluetoothService.ConnectedDeviceName</strong>
                <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="Disconnect">
                    Desconectar
                </button>
            </div>
        }
        else
        {
            <span class="badge bg-secondary">Sin conexión</span>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Escanear dispositivos</h5>
        <button class="btn btn-primary" @onclick="ScanDevices" disabled="@_isScanning">
            @(_isScanning ? "Escaneando... (10s)" : "Buscar impresoras Honeywell")
        </button>

        @if (_devices.Any())
        {
            <div class="mt-3">
                <h6>Dispositivos encontrados:</h6>
                <div class="list-group">
                    @foreach (var device in _devices)
                    {
                        <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                @onclick="() => Connect(device.Id)">
                            <div>
                                <strong>@device.Name</strong>
                                <br />
                                <small class="text-muted">@device.Id</small>
                            </div>
                            <div class="text-end">
                                <small>RSSI: @device.Rssi dBm</small>
                                <br />
                                <span class="badge bg-primary">Conectar</span>
                            </div>
                        </button>
                    }
                </div>
            </div>
        }
        else if (!_isScanning)
        {
            <p class="text-muted mt-2 small">No se han encontrado impresoras. Asegúrese de que el Bluetooth esté activo.</p>
        }
    </div>
</div>

@if (BluetoothService.IsConnected)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Prueba de impresión</h5>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label>Producto</label>
                    <input class="form-control" @bind="_testProduct" placeholder="Nombre del producto" />
                </div>
                <div class="col-3">
                    <label>SKU</label>
                    <input class="form-control" @bind="_testSku" placeholder="SKU-001" />
                </div>
                <div class="col-3">
                    <label>Precio</label>
                    <input class="form-control" type="number" @bind="_testPrice" />
                </div>
            </div>
            <div class="mb-3">
                <label>Código de barras</label>
                <input class="form-control" @bind="_testBarcode" placeholder="123456789012" />
            </div>
            <button class="btn btn-success" @onclick="TestPrint">
                Imprimir etiqueta de prueba
            </button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3">
        @_statusMessage
    </div>
}

@code {
    private List<BluetoothDevice> _devices = [];
    private bool _isScanning;
    private string? _statusMessage;
    private bool _isError;

    private string _testProduct = "Producto de prueba";
    private string _testSku = "TEST-001";
    private string _testBarcode = "012345678901";
    private decimal _testPrice = 9.99m;

    protected override void OnInitialized()
    {
        BluetoothService.DeviceDiscovered += OnDeviceDiscovered;
        BluetoothService.ConnectionStateChanged += OnConnectionStateChanged;
    }

    private async Task ScanDevices()
    {
        _devices.Clear();
        _isScanning = true;
        _statusMessage = null;
        StateHasChanged();

        var found = await BluetoothService.ScanForPrintersAsync(TimeSpan.FromSeconds(10));
        _devices = found.ToList();
        _isScanning = false;

        if (!_devices.Any())
            SetStatus("No se encontraron impresoras Honeywell.", isError: false);
    }

    private async Task Connect(string deviceId)
    {
        SetStatus("Conectando...", isError: false);
        var success = await BluetoothService.ConnectAsync(deviceId);
        SetStatus(success ? "Conectado exitosamente." : "No se pudo conectar. Intente de nuevo.", !success);
    }

    private async Task Disconnect()
    {
        await BluetoothService.DisconnectAsync();
        SetStatus("Desconectado.", isError: false);
    }

    private async Task TestPrint()
    {
        var success = await BluetoothService.PrintProductLabelAsync(
            _testProduct, _testSku, _testBarcode, _testPrice);
        SetStatus(success ? "Etiqueta enviada correctamente." : "Error al imprimir.", !success);
    }

    private void OnDeviceDiscovered(object? sender, BluetoothDevice device)
    {
        if (!_devices.Any(d => d.Id == device.Id))
        {
            _devices.Add(device);
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnConnectionStateChanged(object? sender, bool connected)
    {
        SetStatus(connected ? "Impresora conectada." : "Impresora desconectada.", isError: false);
        InvokeAsync(StateHasChanged);
    }

    private void SetStatus(string msg, bool isError)
    {
        _statusMessage = msg;
        _isError = isError;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BluetoothService.DeviceDiscovered -= OnDeviceDiscovered;
        BluetoothService.ConnectionStateChanged -= OnConnectionStateChanged;
    }
}

@page "/bluetooth"
@inject IBluetoothPrinterService BluetoothService
@implements IDisposable

<PageTitle>Impresora Bluetooth</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Impresora Honeywell Bluetooth</MudText>

<MudCard Class="mb-3">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-2">Estado de conexión</MudText>
        @if (BluetoothService.IsConnected)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudChip Color="Color.Success" Size="Size.Small">Conectado</MudChip>
                <MudText><b>@BluetoothService.ConnectedDeviceName</b></MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           OnClick="Disconnect">
                    Desconectar
                </MudButton>
            </MudStack>
        }
        else
        {
            <MudChip Color="Color.Default" Size="Size.Small">Sin conexión</MudChip>
        }
    </MudCardContent>
</MudCard>

<MudCard Class="mb-3">
    <MudCardContent>
        <MudText Typo="Typo.h6" Class="mb-2">Escanear dispositivos</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ScanDevices" Disabled="@_isScanning">
            @(_isScanning ? "Escaneando... (10s)" : "Buscar impresoras Honeywell")
        </MudButton>

        @if (_devices.Any())
        {
            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Dispositivos encontrados:</MudText>
            <MudList T="BluetoothDevice" Clickable="true">
                @foreach (var device in _devices)
                {
                    <MudListItem T="BluetoothDevice" OnClick="() => Connect(device.Id)">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%">
                            <MudStack Spacing="0">
                                <MudText><b>@device.Name</b></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@device.Id</MudText>
                            </MudStack>
                            <MudStack AlignItems="AlignItems.End" Spacing="0">
                                <MudText Typo="Typo.caption">RSSI: @device.Rssi dBm</MudText>
                                <MudChip Color="Color.Primary" Size="Size.Small">Conectar</MudChip>
                            </MudStack>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }
        else if (!_isScanning)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                No se han encontrado impresoras. Asegúrese de que el Bluetooth esté activo.
            </MudText>
        }
    </MudCardContent>
</MudCard>

@if (BluetoothService.IsConnected)
{
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-3">Prueba de impresión</MudText>
            <MudGrid Class="mb-3">
                <MudItem xs="6">
                    <MudTextField @bind-Value="_testProduct" Label="Producto" Variant="Variant.Outlined"
                                  Placeholder="Nombre del producto" FullWidth="true" />
                </MudItem>
                <MudItem xs="3">
                    <MudTextField @bind-Value="_testSku" Label="SKU" Variant="Variant.Outlined"
                                  Placeholder="SKU-001" FullWidth="true" />
                </MudItem>
                <MudItem xs="3">
                    <MudTextField @bind-Value="_testPrice" Label="Precio" Variant="Variant.Outlined"
                                  InputType="InputType.Number" FullWidth="true" />
                </MudItem>
            </MudGrid>
            <MudTextField @bind-Value="_testBarcode" Label="Código de barras" Variant="Variant.Outlined"
                          Placeholder="123456789012" FullWidth="true" Class="mb-3" />
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="TestPrint">
                Imprimir etiqueta de prueba
            </MudButton>
        </MudCardContent>
    </MudCard>
}

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <MudAlert Severity="@(_isError ? Severity.Error : Severity.Success)" Class="mt-3">
        @_statusMessage
    </MudAlert>
}

@code {
    private List<BluetoothDevice> _devices = [];
    private bool _isScanning;
    private string? _statusMessage;
    private bool _isError;

    private string _testProduct = "Producto de prueba";
    private string _testSku = "TEST-001";
    private string _testBarcode = "012345678901";
    private decimal _testPrice = 9.99m;

    protected override void OnInitialized()
    {
        BluetoothService.DeviceDiscovered += OnDeviceDiscovered;
        BluetoothService.ConnectionStateChanged += OnConnectionStateChanged;
    }

    private async Task ScanDevices()
    {
        _devices.Clear();
        _isScanning = true;
        _statusMessage = null;
        StateHasChanged();

        var found = await BluetoothService.ScanForPrintersAsync(TimeSpan.FromSeconds(10));
        _devices = found.ToList();
        _isScanning = false;

        if (!_devices.Any())
            SetStatus("No se encontraron impresoras Honeywell.", isError: false);
    }

    private async Task Connect(string deviceId)
    {
        SetStatus("Conectando...", isError: false);
        var success = await BluetoothService.ConnectAsync(deviceId);
        SetStatus(success ? "Conectado exitosamente." : "No se pudo conectar. Intente de nuevo.", !success);
    }

    private async Task Disconnect()
    {
        await BluetoothService.DisconnectAsync();
        SetStatus("Desconectado.", isError: false);
    }

    private async Task TestPrint()
    {
        var success = await BluetoothService.PrintProductLabelAsync(
            _testProduct, _testSku, _testBarcode, _testPrice);
        SetStatus(success ? "Etiqueta enviada correctamente." : "Error al imprimir.", !success);
    }

    private void OnDeviceDiscovered(object? sender, BluetoothDevice device)
    {
        if (!_devices.Any(d => d.Id == device.Id))
        {
            _devices.Add(device);
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnConnectionStateChanged(object? sender, bool connected)
    {
        SetStatus(connected ? "Impresora conectada." : "Impresora desconectada.", isError: false);
        InvokeAsync(StateHasChanged);
    }

    private void SetStatus(string msg, bool isError)
    {
        _statusMessage = msg;
        _isError = isError;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BluetoothService.DeviceDiscovered -= OnDeviceDiscovered;
        BluetoothService.ConnectionStateChanged -= OnConnectionStateChanged;
    }
}

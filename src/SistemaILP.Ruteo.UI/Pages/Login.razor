@page "/"
@page "/login"
@attribute [AllowAnonymous]
@layout Layout.LoginLayout
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<div class="d-flex justify-center mb-1">
    <img src="images/logo-la-popular.svg" alt="La Popular" style="width: 220px; max-width: 80%; height: auto;" />
</div>

<MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary" Class="d-flex justify-center mb-8">
    Cuenta demo: <b>&nbsp;demo&nbsp;</b> / <b>&nbsp;Demo123!</b>
</MudText>

<MudForm @ref="_form" Model="_model" @bind-IsValid="_isValid">
    <MudText Typo="Typo.subtitle2" Class="mb-1" Style="font-weight: 600;">
        Usuario <span style="color: var(--mud-palette-error);">*</span>
    </MudText>
    <MudTextField T="string"
                  @bind-Value="_model.UserNameOrEmail"
                  Placeholder="Ingrese su usuario"
                  Variant="Variant.Outlined"
                  Class="rounded-lg mb-4"
                  Required="true"
                  RequiredError="Este campo es obligatorio"
                  Immediate="true" />

    <MudText Typo="Typo.subtitle2" Class="mb-1" Style="font-weight: 600;">
        Contraseña <span style="color: var(--mud-palette-error);">*</span>
    </MudText>
    <MudTextField T="string"
                  @bind-Value="_model.Password"
                  Placeholder="Ingrese su contraseña"
                  Variant="Variant.Outlined"
                  Class="rounded-lg mb-2"
                  InputType="@_passwordInput"
                  Adornment="Adornment.End"
                  AdornmentIcon="@_passwordAdornmentIcon"
                  OnAdornmentClick="TogglePasswordVisibility"
                  Required="true"
                  RequiredError="Este campo es obligatorio"
                  Immediate="true" />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2 mb-2" Dense="true">@_errorMessage</MudAlert>
    }

    <MudButton Variant="Variant.Filled"
               FullWidth="true"
               Disabled="@(!_isValid || _isBusy)"
               OnClick="LoginAsync"
               Class="btn-brand-gradient mt-4 py-3">
        @if (_isBusy)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        Ingresar
    </MudButton>
</MudForm>

@code {
    private readonly LoginRequestDto _model = new();
    private MudForm _form = null!;
    private bool _isValid;
    private bool _isBusy;
    private string? _errorMessage;

    private bool _passwordVisible;
    private InputType _passwordInput = InputType.Password;
    private string _passwordAdornmentIcon = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        // "/" is this page, so an already-authenticated user landing here
        // (app relaunch with a saved session) needs to be sent straight to
        // the app instead of seeing the login form again.
        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser is not null)
        {
            NavigationManager.NavigateTo("/inicio", forceLoad: true);
        }
    }

    private void TogglePasswordVisibility()
    {
        _passwordVisible = !_passwordVisible;
        _passwordInput = _passwordVisible ? InputType.Text : InputType.Password;
        _passwordAdornmentIcon = _passwordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task LoginAsync()
    {
        await _form.Validate();
        if (!_isValid)
        {
            return;
        }

        _isBusy = true;
        _errorMessage = null;

        var result = await AuthService.LoginAsync(_model);

        _isBusy = false;

        if (!result.Succeeded)
        {
            _errorMessage = result.Error;
            return;
        }

        Snackbar.Add($"Bienvenido, {result.Data!.DisplayName}", Severity.Success);
        NavigationManager.NavigateTo("/inicio", forceLoad: true);
    }
}

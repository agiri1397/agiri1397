@page "/perfil"
@attribute [Authorize]
@inject IAuthService AuthService

<MudText Typo="Typo.h4" Class="mb-6">Perfil</MudText>

@if (_currentUser is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudCard>
        <MudCardContent>
            <div class="d-flex align-center mb-4" style="gap: 16px;">
                <MudAvatar Color="Color.Primary" Size="Size.Large">
                    @(_currentUser.DisplayName.Length > 0 ? _currentUser.DisplayName[0].ToString().ToUpperInvariant() : "?")
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h6">@_currentUser.DisplayName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@@@_currentUser.UserName</MudText>
                </div>
            </div>
            <MudDivider Class="mb-4" />
            <MudText Typo="Typo.body1"><b>Correo:</b> @_currentUser.Email</MudText>
        </MudCardContent>
    </MudCard>
}

@code {
    private CurrentUserDto? _currentUser;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await AuthService.GetCurrentUserAsync();
    }
}

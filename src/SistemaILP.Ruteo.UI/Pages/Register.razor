@page "/register"
@attribute [AllowAnonymous]
@layout Layout.LoginLayout
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-6">Crear cuenta</MudText>

<MudForm @ref="_form" Model="_model" @bind-IsValid="_isValid">
    <MudTextField T="string" Label="Nombre para mostrar" @bind-Value="_model.DisplayName" Class="mb-3" />

    <MudTextField T="string"
                  Label="Usuario"
                  @bind-Value="_model.UserName"
                  Required="true"
                  RequiredError="Este campo es obligatorio"
                  Immediate="true"
                  Class="mb-3" />

    <MudTextField T="string"
                  Label="Correo electrónico"
                  @bind-Value="_model.Email"
                  InputType="InputType.Email"
                  Required="true"
                  RequiredError="Este campo es obligatorio"
                  Immediate="true"
                  Class="mb-3" />

    <MudTextField T="string"
                  Label="Contraseña"
                  @bind-Value="_model.Password"
                  InputType="InputType.Password"
                  Required="true"
                  RequiredError="Este campo es obligatorio"
                  HelperText="Mínimo 6 caracteres"
                  Immediate="true"
                  Class="mb-2" />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_errorMessage</MudAlert>
    }

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Disabled="@(!_isValid || _isBusy)"
               OnClick="RegisterAsync"
               Class="mt-2">
        @if (_isBusy)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        Registrarme
    </MudButton>

    <MudButton Variant="Variant.Text" FullWidth="true" Class="mt-2" Href="/login">
        Ya tengo una cuenta
    </MudButton>
</MudForm>

@code {
    private readonly RegisterRequestDto _model = new();
    private MudForm _form = null!;
    private bool _isValid;
    private bool _isBusy;
    private string? _errorMessage;

    private async Task RegisterAsync()
    {
        await _form.Validate();
        if (!_isValid)
        {
            return;
        }

        _isBusy = true;
        _errorMessage = null;

        var result = await AuthService.RegisterAsync(_model);

        _isBusy = false;

        if (!result.Succeeded)
        {
            _errorMessage = result.Error;
            return;
        }

        Snackbar.Add("Cuenta creada correctamente", Severity.Success);
        NavigationManager.NavigateTo("/todos", forceLoad: true);
    }
}

@inject IConnectionSettingsService ConnectionSettings

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Dirección del servidor de Web Services. Solo cámbiala si soporte técnico te lo indica.
        </MudText>
        <MudTextField T="string"
                      @bind-Value="_url"
                      Label="URL del servidor"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Error="@(_error is not null)"
                      ErrorText="@_error" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="RestablecerAsync">Restablecer</MudButton>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = null!;

    private string _url = string.Empty;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _url = await ConnectionSettings.GetBaseUrlAsync();
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task GuardarAsync()
    {
        if (!Uri.TryCreate(_url.Trim(), UriKind.Absolute, out var parsed) ||
            (parsed.Scheme != Uri.UriSchemeHttp && parsed.Scheme != Uri.UriSchemeHttps))
        {
            _error = "Ingresa una URL válida (debe iniciar con http:// o https://).";
            return;
        }

        await ConnectionSettings.SetBaseUrlAsync(_url.Trim());
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task RestablecerAsync()
    {
        await ConnectionSettings.ResetToDefaultAsync();
        _url = await ConnectionSettings.GetBaseUrlAsync();
        _error = null;
    }
}

@using SistemaILP.Ruteo.Application.Common

@if (!string.IsNullOrWhiteSpace(Text))
{
    <MudAlert Severity="@MessageIcons.SeverityFor(Type)"
              Icon="@MessageIcons.For(Type)"
              Variant="Variant"
              Dense="Dense"
              Class="@Class">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@Title</MudText>
        }
        <MudText Typo="Typo.body2">@Text</MudText>
    </MudAlert>
}

@code {
    /// <summary>Tipo de mensaje: decide icono y color (ver MessageIcons).</summary>
    [Parameter]
    public MessageType Type { get; set; } = MessageType.Info;

    [Parameter]
    public string? Title { get; set; }

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public Variant Variant { get; set; } = Variant.Filled;

    [Parameter]
    public bool Dense { get; set; }
}

@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<MudNavMenu Class="pt-2">
    <MudNavLink Href="/todos" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.CheckBox">Tareas (SQLite)</MudNavLink>
    <MudNavLink Href="/posts" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.CloudSync">Posts (Web Service)</MudNavLink>
    <MudDivider Class="my-2" />
    <MudButton Variant="Variant.Text"
               Color="Color.Inherit"
               FullWidth="true"
               StartIcon="@Icons.Material.Filled.Logout"
               Class="justify-start px-4"
               OnClick="LogoutAsync">
        Cerrar sesión
    </MudButton>
</MudNavMenu>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}

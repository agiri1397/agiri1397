@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<MudNavMenu Class="pt-2">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.CheckBox">Tareas (SQLite)</MudNavLink>
    <MudNavLink Href="/posts" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.CloudSync">Posts (Web Service)</MudNavLink>
    <MudDivider Class="my-2" />
    <MudNavLink OnClick="LogoutAsync" Icon="@Icons.Material.Filled.Logout">Cerrar sesión</MudNavLink>
</MudNavMenu>

@code {
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login", replace: true);
    }
}
